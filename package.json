{
	"name": "uni-app",
	"type": "commonjs",
	"version": "0.0.1",
	"description": "最好的 uniapp 开发模板",
	"author": {
		"name": "vyron",
		"email": "vyronfiee@gmail.com",
		"github": "https://github.com/vfiee"
	},
	"license": "MIT",
	"repository": "https://github.com/vfiee/project-boilerplate",
	"bugs": {
		"url": "https://github.com/vfiee/project-boilerplate/issues"
	},
	"homepage": "https://github.com/vfiee/project-boilerplate/tree/uniapp-ts",
	"engines": {
		"node": ">=20",
		"pnpm": ">=10.0.0"
	},
	"scripts": {
		"preinstall": "npx only-allow pnpm",
		"uvm": "npx @dcloudio/uvm@latest --manager pnpm",
		"uvm-rm": "node ./scripts/postupgrade.js",
		"upgrade:uniapp": "pnpm uvm && pnpm uvm-rm",
		"dev": "uni",
		"dev:app": "uni -p app",
		"dev:android": "uni -p app-android",
		"dev:ios": "uni -p app-ios",
		"dev:h5": "uni",
		"dev:h5:ssr": "uni --ssr",
		"dev:weixin": "uni -p mp-weixin",
		"build": "uni build",
		"build:app": "uni build -p app",
		"build:android": "uni build -p app-android",
		"build:ios": "uni build -p app-ios",
		"build:h5": "uni build",
		"build:h5:ssr": "uni build --ssr",
		"build:weixin": "uni build -p mp-weixin",
		"type-check": "vue-tsc --noEmit",
		"release": "bumpp -y --all"
	},
	"lint-staged": {
		"**/*.{html,vue,ts,cjs,json,md}": [
			"prettier --write"
		],
		"**/*.{vue,js,ts,jsx,tsx}": [
			"eslint --cache --fix"
		],
		"**/*.{vue,css,scss,html}": [
			"stylelint --fix"
		]
	},
	"resolutions": {
		"bin-wrapper": "npm:bin-wrapper-china"
	},
	"dependencies": {
		"@dcloudio/uni-app": "3.0.0-4050720250324001",
		"@dcloudio/uni-app-plus": "3.0.0-4050720250324001",
		"@dcloudio/uni-components": "3.0.0-4050720250324001",
		"@dcloudio/uni-h5": "3.0.0-4050720250324001",
		"@dcloudio/uni-mp-weixin": "3.0.0-4050720250324001",
		"@uni-helper/uni-network": "^0.21.1",
		"@vueuse/core": "^9.13.0",
		"abortcontroller-polyfill": "^1.7.8",
		"dayjs": "1.11.10",
		"lodash-es": "^4.17.21",
		"pinia": "2.0.36",
		"pinia-plugin-persistedstate": "3.2.1",
		"qs": "6.5.3",
		"vue": "3.4.21",
		"wot-design-uni": "^1.8.0"
	},
	"devDependencies": {
		"@dcloudio/types": "^3.4.14",
		"@dcloudio/uni-automator": "3.0.0-4050720250324001",
		"@dcloudio/uni-cli-shared": "3.0.0-4050720250324001",
		"@dcloudio/uni-stacktracey": "3.0.0-4050720250324001",
		"@dcloudio/vite-plugin-uni": "3.0.0-4050720250324001",
		"@esbuild/darwin-arm64": "0.20.2",
		"@esbuild/darwin-x64": "0.20.2",
		"@iconify-json/carbon": "^1.2.8",
		"@rollup/rollup-darwin-x64": "^4.38.0",
		"@types/fs-extra": "^11.0.4",
		"@types/node": "^20.17.28",
		"@types/qs": "^6.9.18",
		"@types/wechat-miniprogram": "^3.4.8",
		"@typescript-eslint/eslint-plugin": "^6.21.0",
		"@typescript-eslint/parser": "^6.21.0",
		"@uni-helper/uni-types": "1.0.0-alpha.3",
		"@uni-helper/vite-plugin-uni-layouts": "^0.1.10",
		"@uni-helper/vite-plugin-uni-manifest": "^0.2.8",
		"@uni-helper/vite-plugin-uni-pages": "0.2.20",
		"@uni-helper/vite-plugin-uni-platform": "^0.0.4",
		"@unocss/preset-legacy-compat": "^0.59.4",
		"@vue/runtime-core": "^3.5.13",
		"@vue/tsconfig": "^0.1.3",
		"@vyron/prettier-config": "^0.1.0",
		"bumpp": "^10.1.0",
		"eslint": "^8.57.1",
		"eslint-config-prettier": "^9.1.0",
		"eslint-config-standard": "^17.1.0",
		"eslint-import-resolver-typescript": "^3.10.0",
		"eslint-plugin-import": "^2.31.0",
		"eslint-plugin-prettier": "^5.2.5",
		"eslint-plugin-vue": "^9.33.0",
		"lint-staged": "^15.5.0",
		"openapi-ts-request": "^1.3.0",
		"postcss": "^8.5.3",
		"postcss-html": "^1.8.0",
		"postcss-scss": "^4.0.9",
		"rollup-plugin-visualizer": "^5.14.0",
		"sass": "1.77.8",
		"standard-version": "^9.5.0",
		"stylelint": "^16.17.0",
		"stylelint-config-html": "^1.1.0",
		"stylelint-config-recess-order": "^4.6.0",
		"stylelint-config-recommended": "^14.0.1",
		"stylelint-config-recommended-scss": "^14.1.0",
		"stylelint-config-recommended-vue": "^1.6.0",
		"stylelint-prettier": "^5.0.3",
		"terser": "^5.39.0",
		"typescript": "^5.8.2",
		"unocss": "^0.58.9",
		"unocss-applet": "^0.7.8",
		"unplugin-auto-import": "^0.17.8",
		"vite": "5.2.8",
		"vite-plugin-restart": "^0.4.2",
		"vue-tsc": "^1.8.27"
	}
}
