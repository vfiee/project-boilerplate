{
	"name": "a11y-qsl",
	"type": "module",
	"version": "0.0.1",
	"description": "最好的 uniapp 开发模板",
	"author": {
		"name": "vyron",
		"email": "vyronfiee@gmail.com",
		"github": "https://github.com/vfiee"
	},
	"license": "MIT",
	"repository": "https://github.com/vfiee/project-boilerplate",
	"bugs": {
		"url": "https://github.com/vfiee/project-boilerplate/issues"
	},
	"homepage": "https://github.com/vfiee/project-boilerplate/tree/uniapp",
	"engines": {
		"node": ">=20",
		"pnpm": ">=10.0.0"
	},
	"scripts": {
		"preinstall": "npx only-allow pnpm",
		"dev": "uni -p h5",
		"dev:app": "uni -p app",
		"dev:weixin": "uni -p mp-weixin",
		"build": "uni build -p h5",
		"build:app": "uni build -p app",
		"build:ios": "uni build -p app-ios",
		"build:android": "uni build -p app-android",
		"build:weixin": "uni build -p mp-weixin",
		"release": "bumpp -y --all",
		"latest:uniapp": "npx @dcloudio/uvm@latest --manager pnpm",
		"useless:uniapp": "node ./scripts/postUpgrade.js",
		"upgrade:uniapp": "pnpm latest:uniapp && pnpm useless:uniapp",
		"lint": "eslint --cache --fix '{src}/**/*.{js,jsx,ts,tsx,vue}'",
		"prettier": "prettier --write '{src}/**/*.{js,jsx,ts,tsx,vue,json,yml,yaml}'",
		"sign": "keytool -genkey -v -keystore ./certificate/uni-app.jks -keyalg RSA -keysize 2048 -validity 10000 -alias uni-app"
	},
	"lint-staged": {
		"**/*.{html,vue,ts,cjs,json,md}": [
			"prettier --write"
		],
		"**/*.{vue,js,ts,jsx,tsx}": [
			"eslint --cache --fix"
		],
		"**/*.{vue,css,scss,html}": [
			"stylelint --fix"
		]
	},
	"dependencies": {
		"@dcloudio/uni-app": "3.0.0-4060620250520001",
		"@dcloudio/uni-app-plus": "3.0.0-4060620250520001",
		"@dcloudio/uni-components": "3.0.0-4060620250520001",
		"@dcloudio/uni-h5": "3.0.0-4060620250520001",
		"@uni-helper/uni-network": "^0.21.1",
		"@vueuse/core": "^13.1.0",
		"abortcontroller-polyfill": "^1.7.8",
		"dayjs": "1.11.13",
		"lodash-es": "^4.17.21",
		"pinia": "~2.0.36",
		"pinia-plugin-persistedstate": "~4.3.0",
		"qs": "6.5.3",
		"uniapp-router-next": "^1.2.7",
		"vue": "~3.5.16",
		"wot-design-uni": "~1.9.1"
	},
	"devDependencies": {
		"@dcloudio/types": "^3.4.14",
		"@dcloudio/uni-automator": "3.0.0-4060620250520001",
		"@dcloudio/uni-cli-shared": "3.0.0-4060620250520001",
		"@dcloudio/uni-stacktracey": "3.0.0-4060620250520001",
		"@dcloudio/vite-plugin-uni": "3.0.0-4060620250520001",
		"@esbuild/darwin-arm64": "0.25.2",
		"@esbuild/darwin-x64": "0.25.2",
		"@iconify-json/carbon": "^1.2.8",
		"@rollup/rollup-darwin-x64": "^4.40.0",
		"@types/fs-extra": "^11.0.4",
		"@types/lodash-es": "^4.17.12",
		"@types/node": "^22.14.1",
		"@types/qs": "^6.9.18",
		"@types/wechat-miniprogram": "^3.4.8",
		"@uni-helper/uni-types": "1.0.0-alpha.3",
		"@uni-helper/vite-plugin-uni-components": "^0.2.0",
		"@uni-helper/vite-plugin-uni-layouts": "^0.1.10",
		"@uni-helper/vite-plugin-uni-manifest": "^0.2.8",
		"@uni-helper/vite-plugin-uni-pages": "0.2.28",
		"@unocss/preset-legacy-compat": "^0.65.4",
		"@vue/runtime-core": "^3.5.13",
		"@vue/tsconfig": "^0.1.3",
		"@vyron/prettier-config": "^0.1.0",
		"bumpp": "^10.1.0",
		"eslint": "^8.57.1",
		"eslint-config-prettier": "^9.1.0",
		"eslint-config-standard": "^17.1.0",
		"eslint-import-resolver-typescript": "^3.10.0",
		"eslint-plugin-import": "^2.31.0",
		"eslint-plugin-prettier": "^5.2.6",
		"eslint-plugin-vue": "^10.0.0",
		"lint-staged": "^15.5.1",
		"postcss": "^8.5.3",
		"postcss-html": "^1.8.0",
		"postcss-scss": "^4.0.9",
		"rollup-plugin-visualizer": "^5.14.0",
		"sass": "1.77.8",
		"standard-version": "^9.5.0",
		"stylelint": "^16.17.0",
		"stylelint-config-html": "^1.1.0",
		"stylelint-config-recess-order": "^6.0.0",
		"stylelint-config-recommended": "^16.0.0",
		"stylelint-config-recommended-scss": "^14.1.0",
		"stylelint-config-recommended-vue": "^1.6.0",
		"stylelint-prettier": "^5.0.3",
		"terser": "^5.39.0",
		"typescript": "^5.8.3",
		"uni-mini-router": "^0.1.6",
		"unocss": "^0.65.4",
		"unocss-applet": "^0.10.0",
		"unplugin-auto-import": "^0.19.0",
		"unplugin-uni-router": "^1.2.7",
		"vite": "5.2.8",
		"vite-plugin-restart": "^0.4.2",
		"vite-plugin-uni-polyfill": "^0.1.0",
		"vue-tsc": "^2.2.8"
	}
}
